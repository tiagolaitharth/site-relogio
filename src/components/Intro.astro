---
import introVideoSource from '../assets/Luxury_watch_video_in_space_202608091840.mp4';
---

<section class="intro-section" id="intro">
	<video id="introVideo" autoplay muted playsinline preload="auto" class="intro-video-bg">
		<source src={introVideoSource} type="video/mp4" />
		Seu navegador não suporta a reprodução de vídeos.
	</video>
	<div class="intro-overlay" aria-hidden="true"></div>
</section>

<style>
	.intro-section {
		position: relative;
		width: 100%;
		height: 100vh;
		overflow: hidden;
		display: flex;
		justify-content: center;
		align-items: center;
		background-color: #000000;
	}

	.intro-video-bg {
		position: absolute;
		top: 50%;
		left: 50%;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transform: translate(-50%, -50%);
		z-index: 1;
	}

	.intro-overlay {
		position: absolute;
		inset: 0;
		background: radial-gradient(
			circle,
			rgba(4, 2, 8, 0.25) 0%,
			rgba(4, 2, 8, 0.8) 100%
		);
		z-index: 2;
		pointer-events: none;
	}
</style>
