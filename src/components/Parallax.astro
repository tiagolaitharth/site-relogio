---
import layer1 from '../assets/parallax/1.png';
import layer2 from '../assets/parallax/2.png';
import layer3 from '../assets/parallax/3.png';
import layer4 from '../assets/parallax/4.png';
import layer5 from '../assets/parallax/5.png';
import layer6 from '../assets/parallax/6.png';
---

<section class="parallax-section" id="artesanal">
	<div class="parallax-container">
		<img src={layer6.src} alt="Céu e Distância" class="parallax-layer layer-6" id="p-layer6" style="z-index:10;" />
		<img src={layer5.src} alt="Montanhas Distantes" class="parallax-layer layer-5" id="p-layer5" style="z-index:20;" />
		<img src={layer4.src} alt="Montanhas Intermediárias" class="parallax-layer layer-4" id="p-layer4" style="z-index:30;" />
		<img src={layer3.src} alt="Montanhas Próximas" class="parallax-layer layer-3" id="p-layer3" style="z-index:40;" />
		<img src={layer2.src} alt="Montanhas em Foco" class="parallax-layer layer-2" id="p-layer2" style="z-index:50;" />
		<div class="parallax-text-overlay" id="p-text" style="z-index:55;">
			<div class="parallax-badge">Tradição Murano</div>
			<h2 class="parallax-title">Tempo &amp; Natureza</h2>
			<p class="parallax-description">
				A aventurina surgiu de forma acidental e mágica no século XVII. Redentore traz essa mesma
				essência: o encontro harmônico entre a tradição dos mestres de Murano e a precisão da
				relojoaria moderna.
			</p>
		</div>
		<img src={layer1.src} alt="Rochas de Primeiro Plano" class="parallax-layer layer-1" id="p-layer1" style="z-index:60;" />
	</div>
</section>

<style>
	@font-face {
		font-family: 'EB Garamond';
		src: url('../assets/eb-garamond-medium-italic.woff2') format('woff2');
		font-style: normal;
		font-weight: 500;
		font-display: swap;
	}

	.parallax-section {
		position: relative;
		height: 300vh;
		background: var(--bg-dark);
		border-top: 1px solid var(--border-light);
		z-index: 5;
		content-visibility: auto;
	}

	.parallax-container {
		position: sticky;
		top: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		height: 100vh;
		height: 100dvh;
		overflow: hidden;
	}

	.parallax-container::after {
		position: absolute;
		bottom: 0;
		left: 0;
		z-index: 65;
		width: 100%;
		height: 280px;
		background: linear-gradient(to top, #000 0%, transparent 100%);
		pointer-events: none;
		content: '';
	}

	.parallax-layer {
		position: absolute;
		bottom: -32%;
		left: -8%;
		width: 116%;
		height: 160%;
		max-width: none;
		object-fit: cover;
		object-position: center bottom;
		pointer-events: none;
		filter: grayscale(100%) brightness(0.68) contrast(1.15);
		will-change: transform;
		transform-style: preserve-3d;
		backface-visibility: hidden;
	}

	.layer-6 {
		top: -8%;
		bottom: auto;
		width: 116%;
		height: 160%;
	}

	.parallax-text-overlay {
		position: absolute;
		top: 50%;
		left: 50%;
		display: flex;
		flex-direction: column;
		align-items: center;
		max-width: 800px;
		padding: 0 40px;
		font-family: 'Montserrat Local', Montserrat, Arial, sans-serif;
		text-align: center;
		opacity: 0;
		transform: translate(-50%, -50%);
		transition: none;
	}

	.parallax-badge {
		margin-bottom: 16px;
		color: #c2b8e8;
		font-size: 11px;
		font-weight: 600;
		letter-spacing: .25em;
		text-transform: uppercase;
	}

	.parallax-title {
		margin: 0 0 24px;
		color: #fff;
		font-family: 'EB Garamond', Georgia, serif;
		font-size: clamp(36px, 5vw, 64px);
		font-weight: 500;
		line-height: 1.1;
		text-shadow: 0 0 40px rgb(0 0 0 / 95%);
	}

	.parallax-description {
		max-width: 600px;
		margin: 0;
		color: var(--text-secondary);
		font-size: 15px;
		font-weight: 300;
		line-height: 1.8;
		text-shadow: 0 4px 15px rgb(0 0 0 / 95%);
	}

	@media (max-width: 1024px) {
		.parallax-section {
			height: 180vh;
		}

		.parallax-text-overlay {
			top: 25%;
		}

		.parallax-title {
			margin-bottom: 16px;
		}

		.parallax-description {
			font-size: 14px;
			line-height: 1.7;
		}
	}

	@media (max-width: 580px) {
		.parallax-text-overlay {
			top: 20%;
			padding: 0 24px;
		}

		.parallax-title {
			font-size: 32px;
		}
	}
</style>
