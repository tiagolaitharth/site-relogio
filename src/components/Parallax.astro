---
import { Image, getImage } from 'astro:assets';
import layer1 from '../assets/parallax/1.png';
import layer2 from '../assets/parallax/2.png';
import layer3 from '../assets/parallax/3.png';
import layer4 from '../assets/parallax/4.png';
import layer5 from '../assets/parallax/5.png';
import layer6 from '../assets/parallax/6.png';

const [mobileLayer1, mobileLayer2, mobileLayer3, mobileLayer4, mobileLayer5, mobileLayer6] = await Promise.all(
	[layer1, layer2, layer3, layer4, layer5, layer6].map((src) =>
		getImage({ src, width: 1200, format: 'webp', quality: 70 }),
	),
);
---

<section class="parallax-section" id="artesanal">
	<div class="parallax-container">
		<picture class="parallax-picture">
			<source media="(max-width: 580px)" srcset={mobileLayer6.src} type="image/webp" />
			<Image src={layer6} alt="Céu e Distância" class="parallax-layer layer-6" id="p-layer6" style="z-index:10;" format="webp" quality={70} widths={[1440, 1920, 2752]} sizes="116vw" loading="lazy" decoding="async" fetchpriority="low" />
		</picture>
		<picture class="parallax-picture">
			<source media="(max-width: 580px)" srcset={mobileLayer5.src} type="image/webp" />
			<Image src={layer5} alt="Montanhas Distantes" class="parallax-layer layer-5" id="p-layer5" style="z-index:20;" format="webp" quality={70} widths={[1440, 1920, 2752]} sizes="116vw" loading="lazy" decoding="async" fetchpriority="low" />
		</picture>
		<picture class="parallax-picture">
			<source media="(max-width: 580px)" srcset={mobileLayer4.src} type="image/webp" />
			<Image src={layer4} alt="Montanhas Intermediárias" class="parallax-layer layer-4" id="p-layer4" style="z-index:30;" format="webp" quality={70} widths={[1440, 1920, 2752]} sizes="116vw" loading="lazy" decoding="async" fetchpriority="low" />
		</picture>
		<picture class="parallax-picture">
			<source media="(max-width: 580px)" srcset={mobileLayer3.src} type="image/webp" />
			<Image src={layer3} alt="Montanhas Próximas" class="parallax-layer layer-3" id="p-layer3" style="z-index:40;" format="webp" quality={70} widths={[1440, 1920, 2752]} sizes="116vw" loading="lazy" decoding="async" fetchpriority="low" />
		</picture>
		<picture class="parallax-picture">
			<source media="(max-width: 580px)" srcset={mobileLayer2.src} type="image/webp" />
			<Image src={layer2} alt="Montanhas em Foco" class="parallax-layer layer-2" id="p-layer2" style="z-index:50;" format="webp" quality={70} widths={[1440, 1920, 2752]} sizes="116vw" loading="lazy" decoding="async" fetchpriority="low" />
		</picture>
		<div class="parallax-text-overlay" id="p-text" style="z-index:55;">
			<div class="parallax-badge">Tradição Murano</div>
			<h2 class="parallax-title">Tempo &amp; Natureza</h2>
			<p class="parallax-description">
				A aventurina surgiu de forma acidental e mágica no século XVII. Redentore traz essa mesma
				essência: o encontro harmônico entre a tradição dos mestres de Murano e a precisão da
				relojoaria moderna.
			</p>
		</div>
		<picture class="parallax-picture">
			<source media="(max-width: 580px)" srcset={mobileLayer1.src} type="image/webp" />
			<Image src={layer1} alt="Rochas de Primeiro Plano" class="parallax-layer layer-1" id="p-layer1" style="z-index:60;" format="webp" quality={70} widths={[1440, 1920, 2752]} sizes="116vw" loading="lazy" decoding="async" fetchpriority="low" />
		</picture>
	</div>
</section>

<style>
	@font-face {
		font-family: 'EB Garamond';
		src: url('../assets/eb-garamond-medium-italic.woff2') format('woff2');
		font-style: normal;
		font-weight: 500;
		font-display: swap;
	}

	.parallax-section {
		position: relative;
		width: 100%;
		max-width: 100%;
		height: 300vh;
		overflow-x: clip;
		background: var(--bg-dark);
		border-top: 1px solid var(--border-light);
		z-index: 5;
		content-visibility: auto;
	}

	.parallax-container {
		position: sticky;
		top: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		max-width: 100%;
		height: 100vh;
		height: 100dvh;
		overflow: hidden;
		contain: paint;
	}

	.parallax-container::after {
		position: absolute;
		bottom: 0;
		left: 0;
		z-index: 65;
		width: 100%;
		height: 280px;
		background: linear-gradient(to top, #000 0%, transparent 100%);
		pointer-events: none;
		content: '';
	}

	.parallax-picture {
		display: contents;
	}

	.parallax-layer {
		position: absolute;
		bottom: -32%;
		left: -8%;
		width: 116%;
		height: 160%;
		max-width: none;
		object-fit: cover;
		object-position: center bottom;
		pointer-events: none;
		filter: grayscale(100%) brightness(0.68) contrast(1.15);
		will-change: transform;
		transform-style: preserve-3d;
		backface-visibility: hidden;
	}

	.layer-6 {
		top: -8%;
		bottom: auto;
		width: 116%;
		height: 160%;
	}

	.parallax-text-overlay {
		position: absolute;
		top: 50%;
		left: 50%;
		display: flex;
		flex-direction: column;
		align-items: center;
		max-width: 800px;
		padding: 0 40px;
		font-family: 'Montserrat Local', Montserrat, Arial, sans-serif;
		text-align: center;
		opacity: 0;
		transform: translate(-50%, -50%);
		transition: none;
	}

	.parallax-badge {
		margin-bottom: 16px;
		color: #c2b8e8;
		font-size: 11px;
		font-weight: 600;
		letter-spacing: .25em;
		text-transform: uppercase;
	}

	.parallax-title {
		margin: 0 0 24px;
		color: #fff;
		font-family: 'EB Garamond', Georgia, serif;
		font-size: clamp(36px, 5vw, 64px);
		font-weight: 500;
		line-height: 1.1;
		text-shadow: 0 0 40px rgb(0 0 0 / 95%);
	}

	.parallax-description {
		max-width: 600px;
		margin: 0;
		color: var(--text-secondary);
		font-size: 15px;
		font-weight: 300;
		line-height: 1.8;
		text-shadow: 0 4px 15px rgb(0 0 0 / 95%);
	}

	@media (max-width: 1024px) {
		.parallax-section {
			height: 180vh;
		}

		.parallax-text-overlay {
			top: 25%;
		}

		.parallax-title {
			margin-bottom: 16px;
		}

		.parallax-description {
			font-size: 14px;
			line-height: 1.7;
		}
	}

	@media (max-width: 580px) {
		.parallax-section {
			height: 220svh;
		}

		.parallax-container {
			height: 100svh;
		}

		.parallax-container::after {
			height: 34svh;
			background: linear-gradient(to top, #000 0%, rgb(0 0 0 / 72%) 28%, transparent 100%);
		}

		.parallax-layer {
			filter: none;
			opacity: .82;
		}

		.parallax-layer:not(.layer-6) {
			left: -80%;
			bottom: -4%;
			width: 260%;
			height: auto;
			aspect-ratio: 2752 / 1536;
			object-fit: contain;
			object-position: center bottom;
		}

		.layer-1 {
			left: -143%;
			bottom: -7%;
			width: 306%;
		}

		.layer-2 {
			left: -82%;
			bottom: -5%;
			width: 264%;
		}

		.layer-3 {
			left: -77%;
			bottom: 0;
			width: 254%;
		}

		.layer-4 {
			left: -72%;
			bottom: 7%;
			width: 244%;
		}

		.layer-5 {
			left: -67%;
			bottom: 15%;
			width: 234%;
		}

		.layer-6 {
			top: 0;
			left: -85%;
			width: 270%;
			height: 100%;
			object-fit: cover;
			object-position: center top;
		}

		.parallax-text-overlay {
			top: 31%;
			width: calc(100% - 32px);
			max-width: 430px;
			padding: 0 12px;
		}

		.parallax-title {
			margin-bottom: 14px;
			font-size: clamp(32px, 10vw, 40px);
		}

		.parallax-badge {
			margin-bottom: 12px;
			font-size: 10px;
		}

		.parallax-description {
			max-width: 35ch;
			font-size: 13px;
			line-height: 1.65;
		}
	}
</style>
