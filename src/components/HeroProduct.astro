---
import { Image } from 'astro:assets';
import heroBackground from '../assets/imagem3.png';
---

<section id="hero" class="hero-section">
	<Image
		src={heroBackground}
		alt=""
		class="hero-background"
		format="webp"
		quality={76}
		widths={[640, 960, 1280, 1672]}
		sizes="100vw"
		loading="lazy"
		decoding="async"
		fetchpriority="low"
	/>
	<div class="hero-container">
		<div class="hero-content" data-hero-content>
			<h1 class="hero-title">
				<span data-hero-word>VENEZIANICO</span>
				<span data-hero-word>REDENTORE</span>
			</h1>

			<p class="hero-description" data-hero-detail>
				Um tributo à beleza mística do céu veneziano. O dial em autêntico vidro de Aventurina
				capta o brilho eterno das estrelas, unindo o requinte da lapidação artesanal ao coração
				mecânico do calibre Seiko NH35A.
			</p>

			<div class="hero-actions" data-hero-detail>
				<a href="#adquirir" class="btn-solid" id="btnHeroReserve">Reservar Edição</a>
				<a href="#especificacoes-detalhadas" class="btn-outline" id="btnHeroSpecs">
					Especificações
				</a>
			</div>

			<div class="specs-bar" data-hero-detail>
				<div class="spec-item">
					<span class="spec-value">Seiko NH35A</span>
					<span class="spec-label">Calibre</span>
				</div>
				<div class="spec-item">
					<span class="spec-value">Cristal Safira</span>
					<span class="spec-label">Vidro</span>
				</div>
				<div class="spec-item">
					<span class="spec-value">Aço 316L</span>
					<span class="spec-label">Caixa</span>
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	const heroSection = document.getElementById('hero');
	const heroContent = document.querySelector('[data-hero-content]');
	const heroWords = document.querySelectorAll('[data-hero-word]');
	const heroDetails = document.querySelectorAll('[data-hero-detail]');
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	let heroFrameRequested = false;

	const clamp = (value, min = 0, max = 1) => Math.max(min, Math.min(max, value));

	const revealElement = (element, progress, start, end, distance) => {
		if (!(element instanceof HTMLElement)) return;
		const localProgress = clamp((progress - start) / (end - start));
		const easedProgress = localProgress * localProgress * (3 - 2 * localProgress);
		element.style.opacity = `${easedProgress}`;
		element.style.transform = `translate3d(0, ${distance * (1 - easedProgress)}px, 0)`;
	};

	const updateHeroReveal = () => {
		if (!heroSection || !heroContent || reduceMotion) return;

		const rect = heroSection.getBoundingClientRect();
		const viewHeight = window.innerHeight;
		const progress = clamp((viewHeight - rect.top) / (viewHeight * 0.72));

		revealElement(heroWords[0], progress, 0.04, 0.38, 28);
		revealElement(heroWords[1], progress, 0.25, 0.59, 28);
		revealElement(heroDetails[0], progress, 0.48, 0.72, 18);
		revealElement(heroDetails[1], progress, 0.61, 0.84, 18);
		revealElement(heroDetails[2], progress, 0.73, 0.96, 18);
	};

	const requestHeroReveal = () => {
		if (heroFrameRequested) return;
		heroFrameRequested = true;

		requestAnimationFrame(() => {
			updateHeroReveal();
			heroFrameRequested = false;
		});
	};

	if (heroContent && !reduceMotion) {
		heroContent.classList.add('is-scroll-reveal');
		window.addEventListener('scroll', requestHeroReveal, { passive: true });
		window.addEventListener('resize', requestHeroReveal);
		requestHeroReveal();
	}
</script>

<style>
	@font-face {
		font-family: 'EB Garamond Hero';
		src: url('../assets/eb-garamond-medium-italic.woff2') format('woff2');
		font-style: italic;
		font-weight: 500;
		font-display: swap;
	}

	.hero-section {
		position: relative;
		width: 100%;
		min-height: 100vh;
		min-height: 100dvh;
		overflow: hidden;
		background-color: #080b10;
	}

	.hero-background {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	.hero-container {
		position: relative;
		z-index: 1;
		display: flex;
		align-items: center;
		justify-content: flex-end;
		width: min(100%, 1600px);
		min-height: inherit;
		margin: 0 auto;
		padding: 130px clamp(48px, 6vw, 96px) 72px;
	}

	.hero-content {
		width: min(44vw, 540px);
		color: #fff;
		font-family: 'Montserrat Local', Montserrat, Arial, sans-serif;
	}

	.hero-content.is-scroll-reveal .hero-title span,
	.hero-content.is-scroll-reveal .hero-description,
	.hero-content.is-scroll-reveal .hero-actions,
	.hero-content.is-scroll-reveal .specs-bar {
		opacity: 0;
		will-change: opacity, transform;
	}

	.hero-title {
		margin: 0;
		color: #fff;
		font-family: 'EB Garamond Hero', Georgia, serif;
		font-size: clamp(48px, 5vw, 80px);
		font-style: italic;
		font-weight: 500;
		font-synthesis: none;
		letter-spacing: .01em;
		line-height: .96;
	}

	.hero-title span {
		display: block;
	}

	.hero-description {
		max-width: 480px;
		margin: 30px 0 0;
		color: #d2d5dc;
		font-size: clamp(14px, 1.05vw, 16px);
		font-weight: 400;
		line-height: 1.75;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: 34px;
	}

	.hero-actions a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 48px;
		padding: 0 24px;
		border: 1px solid transparent;
		font-size: 11px;
		font-weight: 700;
		letter-spacing: .12em;
		text-decoration: none;
		text-transform: uppercase;
		transition: transform 180ms ease, background-color 180ms ease, border-color 180ms ease;
	}

	.btn-solid {
		color: #101217;
		background-color: #fff;
	}

	.btn-solid:hover {
		background-color: #e9e9e9;
		transform: translateY(-2px);
	}

	.btn-outline {
		border-color: rgb(255 255 255 / 65%) !important;
		color: #fff;
		background-color: transparent;
	}

	.btn-outline:hover {
		border-color: #fff !important;
		background-color: rgb(255 255 255 / 8%);
		transform: translateY(-2px);
	}

	.specs-bar {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 20px;
		margin-top: 46px;
		padding-top: 24px;
		border-top: 1px solid rgb(255 255 255 / 28%);
	}

	.spec-item {
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.spec-value {
		color: #fff;
		font-size: 13px;
		font-weight: 700;
		line-height: 1.35;
	}

	.spec-label {
		color: #adb1bb;
		font-size: 10px;
		font-weight: 400;
		letter-spacing: .14em;
		text-transform: uppercase;
	}

	.hero-actions a:focus-visible {
		outline: 2px solid #fff;
		outline-offset: 4px;
	}

	@media (max-width: 1024px) {
		.hero-background {
			object-position: 54% center;
		}

		.hero-container {
			padding-right: 40px;
			padding-left: 40px;
		}

		.hero-content {
			width: min(48vw, 470px);
		}

		.hero-title {
			font-size: clamp(40px, 6vw, 62px);
		}
	}

	@media (max-width: 700px) {
		.hero-background {
			object-position: 58% center;
		}

		.hero-container {
			align-items: flex-start;
			padding: 112px 22px 44px;
		}

		.hero-content {
			width: min(100%, 500px);
			margin-left: auto;
		}

		.hero-title {
			font-size: clamp(38px, 12vw, 56px);
		}

		.hero-description {
			max-width: 440px;
			margin-top: 22px;
			font-size: 14px;
			line-height: 1.65;
		}

		.hero-actions {
			flex-direction: column;
			margin-top: 26px;
		}

		.hero-actions a {
			width: 100%;
		}

		.specs-bar {
			gap: 12px;
			margin-top: 32px;
			padding-top: 20px;
		}

		.spec-value {
			font-size: 11px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-actions a {
			transition: none;
		}
	}
</style>
