---
import footerLogo from '../assets/venezianico-logo-gold.png';
---

<footer class="site-footer" style="background-color: #000000; color: rgba(255, 255, 255, 0.68);">
	<div class="footer-container">
		<div class="footer-main">
			<div class="footer-newsletter">
				<img src={footerLogo.src} alt="Venezianico" width="120" loading="lazy" />
				<p>Sign up for new stories and personal offers</p>

				<form action="/contact#footer-newsletter" method="post" class="newsletter-form" id="footer-newsletter">
					<input name="form_type" type="hidden" value="customer" />
					<input name="contact[tags]" type="hidden" value="newsletter" />
					<label for="footer-email">E-mail</label>
					<div class="newsletter-control">
						<input id="footer-email" name="contact[email]" type="email" autocomplete="email" required />
						<button type="submit" aria-label="Subscribe">
							<svg aria-hidden="true" viewBox="0 0 24 24">
								<path d="M5 12h13M13 6l6 6-6 6"></path>
							</svg>
						</button>
					</div>
				</form>
			</div>

			<nav class="footer-menu" aria-labelledby="footer-our-world">
				<h2 id="footer-our-world">Our World</h2>
				<ul>
					<li><a href="/pages/our-story">Our Story</a></li>
					<li><a href="/pages/limited-editions">Limited Editions</a></li>
					<li><a href="/blogs/journal">Journal</a></li>
					<li><a href="/pages/inspiration">Inspiration</a></li>
					<li><a href="/pages/values">Values</a></li>
				</ul>
			</nav>

			<nav class="footer-menu" aria-labelledby="footer-collections">
				<h2 id="footer-collections">Collections</h2>
				<ul>
					<li><a href="/collections/all-watches">All Watches</a></li>
					<li><a href="/collections/redentore">Redentore</a></li>
					<li><a href="/collections/arsenale">Arsenale</a></li>
					<li><a href="/collections/nereide">Nereide</a></li>
					<li><a href="/collections/bucintoro">Bucintoro</a></li>
				</ul>
			</nav>

			<nav class="footer-menu" aria-labelledby="footer-care">
				<h2 id="footer-care">Customer Care</h2>
				<ul>
					<li><a href="/pages/contact">Contact us</a></li>
					<li><a href="/pages/faq">FAQ</a></li>
					<li><a href="/pages/stores">Stores</a></li>
					<li><a href="/pages/owners-guide">Guide to Your Venezianico</a></li>
					<li><a href="/collections/archive">Past Models</a></li>
				</ul>
			</nav>

			<nav class="footer-menu" aria-labelledby="footer-info">
				<h2 id="footer-info">Info</h2>
				<ul>
					<li><a href="/pages/privacy-policy">Privacy Policy</a></li>
					<li><a href="/pages/cookie-policy">Cookie Policy</a></li>
					<li><a href="/pages/terms-and-conditions">Terms and Conditions</a></li>
					<li><a href="/pages/pre-order-policy">Pre-Order Policy</a></li>
					<li><a href="/pages/anti-counterfeiting">Anti-Counterfeiting</a></li>
				</ul>
			</nav>
		</div>

		<div class="footer-aside">
			<ul class="social-list" aria-hidden="true">
				<li><span class="social-icon">f</span></li>
				<li><span class="social-icon">X</span></li>
				<li>
					<span class="social-icon">
						<svg aria-hidden="true" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle class="fill-dot" cx="17.5" cy="6.5" r="1"></circle></svg>
					</span>
				</li>
				<li>
					<span class="social-icon">
						<svg aria-hidden="true" viewBox="0 0 24 24"><rect x="2.5" y="5.5" width="19" height="13" rx="4"></rect><path class="fill-shape" d="m10 9 6 3-6 3Z"></path></svg>
					</span>
				</li>
				<li><span class="social-icon">♪</span></li>
				<li><span class="social-icon linkedin-mark">in</span></li>
			</ul>

			<div class="footer-bottom">
				<p class="footer-copyright">© 2026, Venezianico Srl | Corso Silvio Trentin 76, 30027, San Donà di Piave (VE), Italy | VAT: 04427770278 | Cap. Soc. IV: €4.470.000,00</p>
				<ul class="payment-list" aria-label="Accepted payment methods">
					<li>AMEX</li>
					<li>Apple Pay</li>
					<li>G Pay</li>
					<li>Maestro</li>
					<li>Mastercard</li>
					<li>PayPal</li>
					<li>Shop Pay</li>
					<li>UnionPay</li>
					<li>VISA</li>
					<li>Klarna</li>
				</ul>
			</div>
		</div>
	</div>
</footer>

<style>
	@font-face {
		font-family: 'Montserrat Footer';
		src: url('../assets/montserrat-regular.woff2') format('woff2');
		font-style: normal;
		font-weight: 400;
		font-display: swap;
	}

	@font-face {
		font-family: 'Montserrat Footer';
		src: url('../assets/montserrat-bold.woff2') format('woff2');
		font-style: normal;
		font-weight: 700;
		font-display: swap;
	}

	.site-footer,
	.site-footer * {
		box-sizing: border-box;
	}

	.site-footer {
		background-color: #000000 !important;
		background-image: none !important;
		color: rgba(255, 255, 255, 0.68);
		color-scheme: dark;
		border-top: 1px solid rgba(255, 255, 255, 0.08);
		padding: 64px 0;
		font-family: 'Montserrat Footer', Montserrat, Arial, sans-serif;
		font-size: 13px;
		line-height: 1.6;
	}

	.footer-container {
		width: 100%;
		max-width: var(--max-width);
		margin: 0 auto;
		padding: 0 60px;
	}

	.footer-main {
		display: grid;
		grid-template-columns: minmax(300px, 1.65fr) repeat(4, minmax(120px, 1fr));
		align-items: start;
		gap: 48px;
	}

	.footer-newsletter {
		display: grid;
		justify-items: start;
		gap: 24px;
	}

	.footer-newsletter img {
		width: 120px;
		height: auto;
		display: block;
	}

	.footer-newsletter p,
	.footer-menu h2,
	.footer-menu ul,
	.footer-copyright {
		margin: 0;
	}

	.footer-newsletter p {
		color: rgba(255, 255, 255, 0.58);
	}

	.newsletter-form {
		width: min(100%, 400px);
	}

	.newsletter-form > label {
		display: block;
		margin-bottom: 3px;
		font-size: 11px;
		color: rgba(255, 255, 255, 0.52);
	}

	.newsletter-control {
		display: flex;
		align-items: center;
		border-bottom: 1px solid rgba(255, 255, 255, 0.22);
	}

	.newsletter-control input {
		width: 100%;
		height: 42px;
		border: 0;
		outline: none;
		background: transparent;
		color: #ffffff;
		font: inherit;
	}

	.newsletter-control:focus-within {
		border-color: #a38d5b;
	}

	.newsletter-control button {
		width: 28px;
		height: 28px;
		border: 0;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.1);
		color: rgba(255, 255, 255, 0.72);
		padding: 6px;
		cursor: pointer;
		transition: color 0.2s ease, background-color 0.2s ease;
	}

	.newsletter-control button:hover {
		background: rgba(255, 255, 255, 0.85);
		color: #000;
	}

	.newsletter-control svg {
		width: 100%;
		height: 100%;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.7;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.footer-menu h2 {
		color: #ffffff;
		font-size: 13px;
		font-weight: 700;
	}

	.footer-menu ul,
	.social-list,
	.payment-list {
		padding: 0;
		list-style: none;
	}

	.footer-menu ul {
		display: grid;
		gap: 10px;
		margin-top: 24px;
	}

	.footer-menu a {
		color: rgba(255, 255, 255, 0.56);
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.footer-menu a:hover {
		color: #ffffff;
	}

	.footer-aside {
		display: grid;
		gap: 32px;
		margin-top: 64px;
		padding-top: 32px;
		border-top: 1px solid rgba(255, 255, 255, 0.12);
	}

	.social-list {
		display: flex;
		align-items: center;
		gap: 22px;
		margin: 0;
	}

	.social-icon {
		display: grid;
		place-items: center;
		width: 20px;
		height: 20px;
		color: #a38d5b;
		font-size: 16px;
		font-weight: 700;
		line-height: 1;
		user-select: none;
	}

	.social-list svg {
		width: 19px;
		height: 19px;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.7;
	}

	.social-list .fill-dot,
	.social-list .fill-shape {
		fill: currentColor;
		stroke: none;
	}

	.linkedin-mark {
		font-size: 13px;
		letter-spacing: -0.04em;
	}

	.footer-bottom {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		gap: 40px;
	}

	.footer-copyright {
		max-width: 720px;
		color: rgba(255, 255, 255, 0.48);
		font-size: 11px;
	}

	.payment-list {
		display: flex;
		justify-content: flex-end;
		flex-wrap: wrap;
		gap: 6px;
		margin: 0;
	}

	.payment-list li {
		display: grid;
		place-items: center;
		min-width: 38px;
		height: 24px;
		padding: 0 6px;
		border: 1px solid rgba(0, 0, 0, 0.1);
		border-radius: 3px;
		background: #fff;
		color: #393836;
		font-size: 7px;
		font-weight: 700;
		white-space: nowrap;
	}

	@media (max-width: 1100px) {
		.footer-main {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}

		.footer-newsletter {
			grid-column: 1 / -1;
		}
	}

	@media (max-width: 700px) {
		.site-footer {
			padding: 48px 0;
		}

		.footer-container {
			padding: 0 24px;
		}

		.footer-main {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 40px 28px;
		}

		.footer-newsletter {
			justify-items: center;
			text-align: center;
		}

		.footer-menu ul {
			margin-top: 16px;
		}

		.footer-aside {
			margin-top: 48px;
		}

		.social-list {
			justify-content: center;
		}

		.footer-bottom {
			align-items: flex-start;
			flex-direction: column;
		}

		.payment-list {
			justify-content: flex-start;
		}
	}
</style>
