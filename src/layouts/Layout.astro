---
interface Props {
	title?: string;
}

const { title = 'Venezianico' } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	:root {
		--bg-dark: #050509;
		--border-light: rgba(255, 255, 255, 0.12);
		--text-secondary: #c2c0ca;
		--font-display: 'Times New Roman', Times, serif;
		--max-width: 1440px;
		--lavender: #c2b8e8;
		--white: #ffffff;
		--ease-out: cubic-bezier(0.22, 1, 0.36, 1);
	}

	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		background: #000;
	}
</style>
