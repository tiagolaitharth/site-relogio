---
import Intro from '../components/Intro.astro';
import Header from '../components/Header.astro';
import Parallax from '../components/Parallax.astro';
import HeroProduct from '../components/HeroProduct.astro';
import BrandMarquee from '../components/BrandMarquee.astro';
import AmbientVideo from '../components/AmbientVideo.astro';
import TechnicalSpecs from '../components/TechnicalSpecs.astro';
import EditorialGallery from '../components/EditorialGallery.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout title="Venezianico">
